# Model provider: ollama (default), lmstudio, or portkey.
# Offline demo and embedded-map play do not contact a model server.
PCG_PROVIDER=ollama
# Per-model-call timeout in seconds, including cold loading. Allowed: 1..1800.
PCG_MODEL_TIMEOUT=120

# Ollama: install/pull a tool-calling model, then copy its ID from `ollama list`.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional Bearer token for an authenticated proxy; not required by local Ollama.
OLLAMA_API_KEY=

# LM Studio: load a tool-calling model and copy its ID from GET /v1/models.
LMSTUDIO_MODEL=
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Optional API token if server authentication is enabled.
LMSTUDIO_API_KEY=

# Portkey is optional. Set PCG_PROVIDER=portkey and fill all three fields.
PORTKEY_API_KEY=
PORTKEY_MODEL=
PORTKEY_BASE_URL=
# Optional Portkey virtual-key or config routing.
PORTKEY_VIRTUAL_KEY=
PORTKEY_CONFIG=

# Unity Editor executable. Leave blank to use the open Editor bridge.
UNITY_EDITOR_PATH=
# Optional USD prices per million tokens for the selected model.
# Blank means cost is unknown; local hardware costs are not calculated.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
