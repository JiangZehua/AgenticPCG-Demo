# Copy to .env and fill these three fields for your own Portkey workspace.
# Offline demo and embedded-map play do not need credentials.
PORTKEY_API_KEY=
# Tool-calling model route configured in your gateway.
PORTKEY_MODEL=
# Full API base URL, including the version path; HTTPS required for remote hosts.
PORTKEY_BASE_URL=
# Optional routing for virtual-key or config-based workspaces.
PORTKEY_VIRTUAL_KEY=
PORTKEY_CONFIG=
# Optional Unity Editor executable. Leave blank to use the open Editor bridge.
UNITY_EDITOR_PATH=
# Optional USD prices per million tokens. Blank means cost is unknown.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
